# copy .env.example .env

# --- DB (PC Postgres, port 5432) ---
# init-db.ps1 가 DB_* 를 자동 채웁니다. 수동 설정 시:
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=taxflow
# DB_USERNAME=taxflow
# DB_PASSWORD=taxflow_dev_password

# init-db.ps1 1회 실행용 (postgres 슈퍼유저 비밀번호, 선택)
# POSTGRES_SUPERUSER_PASSWORD=Postgres설치시_정한_비밀번호

# --- 로그인 (dev 프로필 시드) ---
# demo@taxflow.kr / TaxFlow123!

# --- 인증서 Vault (32-byte Base64, 운영 필수) ---
# TAXFLOW_CERT_MASTER_KEY=

# --- 국세청 사업자 조회 (공공데이터포털) ---
NTS_BIZ_VERIFY_ENABLED=true
NTS_BIZ_VERIFY_SERVICE_KEY=여기에_공공데이터포털_인증키
